# ---- SERV Reasoning (OpenServ) ----------------------------------------------
# Get a key at https://console.openserv.ai
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
# PLANNER=scripted   # offline deterministic planner, for tests/UI dev only

# ---- Network ----------------------------------------------------------------
# eip155:84532 = Base Sepolia: testnet USDC, settled by the public x402.org facilitator
# eip155:8453  = Base mainnet: REAL USDC, settled by Coinbase's CDP facilitator
#                (uses the CDP_API_KEY_ID/SECRET below; first 1,000 settlements/month free)
X402_NETWORK=eip155:84532
# FACILITATOR_URL=   # leave unset to pick automatically by network

# ---- Seller -----------------------------------------------------------------
# Address that receives USDC. Use a DIFFERENT address from the buyer.
SELLER_PAY_TO=
# The seller runs inside the same server as the dashboard, so it needs no port of its own.
# SELLER_URL=https://your-app.vercel.app   # your public URL; set this on Vercel
# SELLER_PORT=4021                          # only for running the seller alone (npm run seller)
# SELLER_CDP_API_KEY_ID= / SELLER_CDP_API_KEY_SECRET=   # if the seller uses a different CDP project
# SELLER_ALLOW_MOCK=true   # dev only, testnet only: lets PAYMENTS=mock buyers skip the paywall

# ---- Buyer wallet (Coinbase AgentKit) ----------------------------------------
# Option A (recommended): CDP server wallet via AgentKit's CdpEvmWalletProvider
# https://portal.cdp.coinbase.com → API keys + wallet secret
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# CDP_WALLET_ADDRESS=   # reuse an existing CDP account; leave blank to create one on first run
# Option B: local key via AgentKit's ViemWalletProvider (npm run wallet -- new)
BUYER_PRIVATE_KEY=
# RPC_URL=

# ---- Buyer policy (enforced in code, not by the model) -----------------------
PAYMENTS=x402            # x402 = real settlement | mock = no money moves
DEFAULT_BUDGET_USD=0.05
PER_CALL_CAP_USD=0.05
# MAX_BUDGET_USD=        # ceiling for any one question: default $1 testnet, $0.25 mainnet
MAX_PURCHASES=5
MAX_STEPS=6
APP_PORT=3000

# ---- Public deployments (Vercel etc.) -----------------------------------------
# Anyone who can open the site could spend from the buyer wallet. Set both.
# DEMO_ACCESS_CODE=pick-a-code        # needed to start a run; share it with judges only
# DAILY_SPEND_CAP_USD=1               # total real USDC the agent may spend per UTC day
# Run history on Vercel: add Upstash Redis from the Vercel Marketplace. It sets
# KV_REST_API_URL and KV_REST_API_TOKEN automatically. Without it history resets.
